@Library('managed-aws') _

pipeline {
    agent any

    parameters {
        string(name: 'AWS_REGION',    defaultValue: 'us-west-1',               description: 'AWS region')
        string(name: 'CREDENTIAL_ID', defaultValue: 'aws-terraform-cred-prod', description: 'Jenkins AWS credential ID')
        choice(name: 'TARGET',        choices: ['alb', 'rds', 'eks', 'vpc'],   description: 'Which component to DESTROY (order matters: alb → rds → eks → vpc)')
    }

    options { timestamps(); disableConcurrentBuilds() }

    stages {
        stage('Destroy') {
            steps {
                script {
                    terraformDestroy(environment: 'prod', target: params.TARGET)
                }
            }
        }
    }

    post {
        success { echo "prod/${params.TARGET} destroyed." }
        failure { echo "prod/${params.TARGET} destroy failed. Check logs above." }
    }
}
