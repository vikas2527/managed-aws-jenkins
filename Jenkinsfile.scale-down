// Scale down EKS node group to save costs.

pipeline {
    agent any

    parameters {
        string(name: 'CLUSTER_NAME',  defaultValue: 'margbooks-dev-eks',       description: 'EKS cluster name')
        string(name: 'NODE_GROUP',    defaultValue: 'margbooks-dev-node-group', description: 'EKS node group name')
        string(name: 'DESIRED_SIZE',  defaultValue: '0',                        description: 'Desired node count (0 = full scale down)')
        string(name: 'AWS_REGION',    defaultValue: 'us-west-1',                description: 'AWS region')
        string(name: 'CREDENTIAL_ID', defaultValue: 'aws-terraform-cred-dev',   description: 'Jenkins AWS credential ID')
    }

    options { timestamps(); disableConcurrentBuilds() }

    stages {
        stage('Scale Down Node Group') {
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding',
                                  credentialsId: params.CREDENTIAL_ID,
                                  accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                                  secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']]) {
                    withEnv(["AWS_DEFAULT_REGION=${params.AWS_REGION}"]) {
                        sh """
                            aws eks update-nodegroup-config \\
                                --cluster-name ${params.CLUSTER_NAME} \\
                                --nodegroup-name ${params.NODE_GROUP} \\
                                --scaling-config minSize=0,maxSize=4,desiredSize=${params.DESIRED_SIZE}
                        """
                    }
                }
            }
        }
    }

    post {
        success { echo "Node group scaled down to ${params.DESIRED_SIZE} nodes." }
        failure { echo "Scale down failed. Check logs above." }
    }
}
